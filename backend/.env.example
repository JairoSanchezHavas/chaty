# ── LLM Backend ───────────────────────────────────────────────────────────────
# "gemini"  → Google AI Studio (requiere GEMINI_API_KEY)
# "vertex"  → Vertex AI (requiere gcloud ADC o GOOGLE_APPLICATION_CREDENTIALS)
LLM_BACKEND=gemini

# ── Google AI Studio (LLM_BACKEND=gemini) ────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Vertex AI (LLM_BACKEND=vertex) ───────────────────────────────────────────
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_CHAT_MODEL=gemini-2.5-flash
# VERTEX_EMBED_MODEL=text-embedding-004
#
# Autenticación ADC (recomendado):
#   gcloud auth application-default login
#
# Autenticación con Service Account:
#   GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/sa-key.json

# ── General ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
TENANTS_DIR=./app/tenants
CORS_ORIGINS=*

# ── Google Calendar — Service Account ────────────────────────────────────────
GOOGLE_SA_CREDENTIALS_PATH=./secrets/gcal-sa.json
REP_CALENDAR_ID=your-calendar-id@group.calendar.google.com
REP_NAME=Dra. Ana Villanueva
REP_EMAIL=ana.villanueva@pharmagen.demo
TIMEZONE=America/Mexico_City
